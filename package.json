{
  "name": "@genfeedai/marketplace",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint && biome check scripts/",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "deps:update": "bun run deps:update:packages && bun run deps:update:actions",
    "deps:update:packages": "bunx npm-check-updates -u --deep --cooldown 3h --reject typescript,@typescript/native && bun install",
    "deps:update:actions": "bun scripts/deps/update-github-action-versions.ts",
    "check": "biome check --fix apps/ scripts/",
    "format": "biome format --write apps/ scripts/",
    "check:action-versions": "bun scripts/deps/check-github-action-versions.ts",
    "check:typescript-toolchain": "bun scripts/deps/check-typescript-toolchain.ts",
    "check:dead-code": "bunx knip@6.44.1 --reporter compact",
    "secretlint": "secretlint '**/*'",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "husky": "9.1.7",
    "secretlint": "14.1.0",
    "turbo": "2.11.13",
    "typescript": "6.0.3"
  }
}
