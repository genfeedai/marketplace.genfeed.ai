{
  "name": "@genfeedai/marketplace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "deps:update": "bunx npm-check-updates -u --deep --reject typescript,@typescript/native && bun install",
    "format": "biome format --write apps/",
    "check": "biome check --fix apps/"
  },
  "overrides": {
    "@genfeedai/constants": "2.2.9",
    "@genfeedai/enums": "2.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@typescript/native": "npm:typescript@7.0.2",
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  }
}
