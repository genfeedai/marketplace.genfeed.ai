# Local PostgreSQL (docker/docker-compose.yml), or use your existing local DB
DATABASE_URL=postgresql://marketplace:marketplace_local@localhost:5433/marketplace?schema=public

# Stripe
# Leave unset for local catalog browsing. Required for payment operations.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Clerk
# Required for authenticated operations; public browsing works without these.
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=

# URLs
MARKETPLACE_URL=http://localhost:3204
GENFEED_API_URL=https://api.genfeed.localhost

# Node
NODE_ENV=development
PORT=3200
