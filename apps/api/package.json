{
  "dependencies": {
    "@clerk/backend": "3.2.7",
    "@genfeedai/enums": "2.3.2",
    "@genfeedai/workflows": "0.3.2",
    "@nestjs/common": "11.1.18",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.18",
    "@nestjs/platform-express": "11.1.18",
    "@nestjs/swagger": "11.2.6",
    "@prisma/adapter-pg": "6.18.0",
    "@prisma/client": "6.18.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "slugify": "1.6.9",
    "stripe": "22.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.18",
    "@nestjs/schematics": "11.0.10",
    "@nestjs/testing": "11.1.18",
    "@types/express": "5.0.6",
    "@types/node": "25.5.2",
    "prisma": "6.18.0",
    "tsc-alias": "1.8.16",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.3"
  },
  "name": "@marketplace/api",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "dev": "nest start --watch",
    "lint": "biome check src/",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "seed:genfeed-core-workflows": "bun run apps/api/scripts/seeds/genfeed-core-workflows.seed.ts",
    "seed:genfeed-core-workflows:live": "bun run apps/api/scripts/seeds/genfeed-core-workflows.seed.ts --live",
    "start": "node -r tsconfig-paths/register dist/main",
    "start:prod": "node -r tsconfig-paths/register dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "version": "0.1.0"
}
