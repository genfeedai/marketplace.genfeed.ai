{
  "dependencies": {
    "@aws-sdk/client-ssm": "3.1169.0",
    "@genfeedai/enums": "2.3.2",
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "slugify": "1.6.9",
    "stripe": "23.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "prisma": "6.19.3",
    "tsc-alias": "1.9.10",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "name": "@marketplace/api",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "dev": "nest start --watch",
    "lint": "biome check .",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "start": "node -r tsconfig-paths/register dist/main",
    "start:prod": "node -r tsconfig-paths/register dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "prisma:migrate": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "version": "0.1.0"
}
