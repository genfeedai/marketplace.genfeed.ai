# Agent session logs are local-only. Both spellings on purpose: canonical is
# lowercase, but a case-sensitive filesystem would not ignore a stray uppercase
# one, and `git add -A` would then commit it.
.agents/sessions/
.agents/SESSIONS/

# Deployment working files and state never belong in source control.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
